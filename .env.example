PROJECT_NAME=Enterprise AI Business Intelligence Platform
API_V1_PREFIX=/api/v1

APP_ENV=development

# ==========================================
# Database Configuration
# ==========================================
# Option 1: Local PostgreSQL (Docker)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=ai_bi_platform
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Option 2: Render PostgreSQL (Cloud)
# Get your database at: https://dashboard.render.com
POSTGRES_HOST=dpg-xxx.oregon-postgres.render.com
POSTGRES_PORT=5432
POSTGRES_DB=ai_bi_postgresql
POSTGRES_USER=ai_bi_postgresql_user
POSTGRES_PASSWORD=your-password

# Async Database URL (for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://ai_bi_postgresql_user:your-password@dpg-xxx.oregon-postgres.render.com/ai_bi_postgresql?sslmode=require

# ==========================================
# Security Settings
# ==========================================
SECRET_KEY=replace-with-a-random-48-byte-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=*
MAX_UPLOAD_MB=10

# ==========================================
# LLM Provider Configuration (Required)
# ==========================================
# Get your API key from your provider (OpenAI, Router, etc.)
OPENAI_API_KEY=sk-your-api-key-here

# For OpenAI-compatible endpoints (Router, DeepInfra, Together, etc.)
# Leave empty to use default OpenAI
OPENAI_BASE_URL=https://your-router-endpoint/v1
OPENAI_MODEL=your-model-name

# Examples:
# OPENAI_BASE_URL=https://router.bynara.id/v1
# OPENAI_MODEL=qwen-3.8-max-free
# OPENAI_BASE_URL=https://api.deepinfra.com/v1
# OPENAI_MODEL=microsoft/Phi-3-mini-128k-instruct

MEMORY_TTL_SECONDS=86400
MEMORY_DATABASE_PATH=.memory.sqlite3
