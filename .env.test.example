# ============================================================================
# Test environment configuration (template).
#
# Copy to `.env.test` and adjust for your local PostgreSQL instance:
#     cp .env.test.example .env.test
#
# `.env.test` itself is git-ignored. The pytest suite (tests/conftest.py) loads
# these values, then builds the schema through `alembic upgrade head` — never
# through create_all — so a running PostgreSQL server is required.
# ============================================================================

APP_ENV=testing

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=test_db
POSTGRES_USER=test
POSTGRES_PASSWORD=test

SECRET_KEY=test-secret-key-for-ci-only-not-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=*
MAX_UPLOAD_MB=10

OPENAI_API_KEY=
